flowchart TD
    subgraph LIGIS["1 - Cote LIGIS (traitement EXISTANT, hors perimetre)"]
        Q["Quotidien LIGIS"] --> EX["Extraction vues CDC<br/>+ alimentation TEC_AUD_CDC"]
    end
    EX --> BCP["2 - BCPIN INEO<br/>toutes les vues ZBCP -> ODS<br/>(OIT_xxx + OIT_TEC_AUD_CDC)"]

    subgraph PKG["3 - Package ODI IOM_LIGIS_TRACE_CSTIMG"]
        A0["A0 - IOM_LIG_A0_POSE_BORNE<br/>borne = MIN(DT_FIN_LSN)"] --> A1["A1 - IOM_LIG_CADRAGE_PERIODE<br/>DA_FIN_DEL_FOR = derniere journee bornee"]
        A1 --> T3["T003 - ref_inittracechgt (MAISON)<br/>fige DA_DON_A_TRT / PWTSDC = KO"]
        T3 --> A["A - IOM_LIG_RECUP_DATES<br/>PITCOT = ] DA_DEB_DEL_TRT ; DA_DON_A_TRT ]"]
        A --> B["B - V_IOM_LIG_DT_TRACES<br/>plus ancienne date TRAITE=0 ET bornee"]
        B --> C{"C - date<br/>trouvee ?"}
        C -- "oui" --> D1["D1 - IOM_LIG_FLAG_OIT"]
        D1 --> D2["D2 - IOM_LIG_PURGE_OWT"]
        D2 --> D3["D3 - IOM_LIG_HISTO_OWT"]
        D3 --> D4["D4 - IOM_LIG_CTRL_JOURNEE"]
        D4 -- "OK" --> E["E - IOM_LIG_FLAG_DATES<br/>TRAITE = 1 (PITCOT)"]
        E --> B
        C -- "non (NULL)" --> T4["T004 - ref_OKfintracechgt (MAISON)<br/>PWTSDC = OK / DA_DEB_DEL_TRT = DA_DON_A_TRT"]
        T4 --> FIN(["FIN OK"])
    end

    BCP --> A0
    D4 -- "KO" --> KO(["Package KO avant T004<br/>PWTSDC reste KO, PWTTRE n'avance pas<br/>journee reprise a la relance"])
