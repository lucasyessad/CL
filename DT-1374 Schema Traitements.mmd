flowchart TD
    subgraph CHAINE["1 - Chaine extraction LIGIS (amont, chaque jour)"]
        Q["Quotidien LIGIS<br/>(heure variable, ex 22h)"] --> EX["Extraction vues CDC<br/>ZBCP_LIGIS_*_V"]
        EX --> B0["ETAPE 0 - POSE BORNE<br/>lit audit CDC (TEC_AUD_CDC)<br/>type QUOTIDIEN / MULTI_JOURS auto"]
    end

    B0 --> BCP["2 - BCPIN<br/>fichiers -> ods.OIT_xxx"]

    subgraph PKG["3 - Package ODI (apres BCPIN)"]
        A["A - RECUP_DATES_A_TRAITER<br/>PITCOT depuis PRTCAL / PWTTRE"] --> B["B - Variable V_DT_TRACES<br/>plus ancienne date TRAITE=0<br/>ET bornee"]
        B --> C{"C - date<br/>trouvee ?"}
        C -- "oui" --> D["D - TRT_JOURNEE (1 bloc SQL)<br/>boucle sur les tables :<br/>flag -> purge -> reouverture<br/>-> fermeture -> insertion<br/>-> controle anti-doublon"]
        D -- "OK" --> E["E - TRAITE = 1<br/>jusqu'a la date incluse<br/>(absorbe les MULTI_JOURS)"]
        E --> B
        C -- "non (NULL)" --> F["F - MAJ PWTTRE<br/>avance DA_DEB_DEL_TRT"]
        F --> FIN(["FIN OK"])
    end

    BCP --> A
    D -- "KO (table en erreur<br/>ou borne absente)" --> KO(["Package KO<br/>date reste TRAITE=0<br/>reprise fine a la relance"])
