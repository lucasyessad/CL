flowchart TD
    subgraph LIGIS["1 - Cote LIGIS (traitement EXISTANT, hors perimetre)"]
        Q["Quotidien LIGIS<br/>(heure variable, ex 22h)"] --> EX["Extraction vues CDC<br/>ZBCP_LIGIS_*_V<br/>+ alimentation TEC_AUD_CDC"]
    end

    EX --> BCP["2 - BCPIN INEO<br/>toutes les vues ZBCP -> ODS<br/>(OIT_xxx + OIT_TEC_AUD_CDC)"]

    subgraph PKG["3 - Package ODI IOM_LIGIS_TRACE_CSTIMG"]
        A0["A0 - IOM_LIG_A0_POSE_BORNE<br/>borne = MIN(DT_FIN_LSN) du perimetre"] --> A["A - IOM_LIG_RECUP_DATES<br/>PITCOT depuis PRTCAL / PWTTRE"]
        A --> B["B - V_IOM_LIG_DT_TRACES<br/>plus ancienne date TRAITE=0 ET bornee"]
        B --> C{"C - date<br/>trouvee ?"}
        C -- "oui" --> D1["D1 - IOM_LIG_FLAG_OIT<br/>image fin de journee (OIT)"]
        D1 --> D2["D2 - IOM_LIG_PURGE_OWT<br/>purge DD_VAL + reouverture"]
        D2 --> D3["D3 - IOM_LIG_HISTO_OWT<br/>fermeture SCD2 + insertion"]
        D3 --> D4["D4 - IOM_LIG_CTRL_JOURNEE<br/>anti-doublon + bilan"]
        D4 -- "OK" --> E["E - IOM_LIG_FLAG_DATES<br/>TRAITE = 1 (absorbe MULTI_JOURS)"]
        E --> B
        C -- "non (NULL)" --> F["F - IOM_LIG_MAJ_PWTTRE<br/>avance DA_DEB_DEL_TRT"]
        F --> FIN(["FIN OK"])
    end

    BCP --> A0
    D4 -- "KO (table en erreur)" --> KO(["Package KO<br/>date reste TRAITE=0<br/>journee recalculee a la relance"])
